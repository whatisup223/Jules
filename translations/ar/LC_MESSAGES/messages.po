msgstr "ليس لديك صلاحية للوصول إلى هذه الصفحة."

#: app.py:246
msgid "Welcome to the Exchange Platform!"
msgstr "أهلاً بك في منصة الصرافة!"

#: app.py:247
msgid ""
"Your account has been created! A starting balance of 1000 USD has been "
"added to your wallet."
msgstr "تم إنشاء حسابك بنجاح! لقد تم إضافة رصيد ابتدائي بقيمة 1000 دولار أمريكي إلى محفظتك."

#: app.py:249 templates/base.html:54
msgid "Register"
msgstr "إنشاء حساب"

#: app.py:267 app.py:286
msgid "Login Successful!"
msgstr "تم تسجيل الدخول بنجاح!"

#: app.py:270
msgid "Login Unsuccessful. Please check email and password"
msgstr "فشل تسجيل الدخول. يرجى التحقق من البريد الإلكتروني وكلمة المرور."

#: app.py:289
msgid "Invalid verification code. Please try again."
msgstr "رمز التحقق غير صالح. حاول مرة أخرى."

#: app.py:317
#, python-format
msgid "Insufficient balance. You have %(balance)s %(currency)s."
msgstr "رصيد غير كافٍ. لديك %(balance)s %(currency)s."

#: app.py:323
#, python-format
msgid "Exchange rate from %(from_code)s to %(to_code)s not found."
msgstr "سعر الصرف من %(from_code)s إلى %(to_code)s غير موجود."

#: app.py:336
#, python-format
msgid ""
"Insufficient balance for exchange and fee. Total required: %(total)s "
"%(currency)s."
msgstr "رصيد غير كافٍ للصرف والرسوم. الإجمالي المطلوب: %(total)s %(currency)s."

#: app.py:370
msgid "Your Transaction Receipt"
msgstr "إيصال معاملتك"

#: app.py:371
#, python-format
msgid ""
"Successfully exchanged %(amount_from)s %(from_code)s to %(amount_to)s "
"%(to_code)s"
msgstr "تم بنجاح صرف %(amount_from)s %(from_code)s إلى %(amount_to)s %(to_code)s"

#: app.py:376
#, python-format
msgid "An error occurred during the transaction: %(error)s"
msgstr "حدث خطأ أثناء المعاملة: %(error)s"

